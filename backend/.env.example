# Copy this file to backend/.env and adjust the values.
PORT=4000
# Long random string used to sign JWT tokens. Keep it secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# SQLite database file (created automatically)
DB_PATH=./data/telecom.db
# Folder where uploaded product images are stored
UPLOAD_DIR=./uploads
# Origin of the React frontend (used for CORS)
CORS_ORIGIN=http://localhost:5173
